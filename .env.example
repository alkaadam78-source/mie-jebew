PORT=3001
JWT_SECRET=your_jwt_secret_key_change_in_production
ADMIN_DEFAULT_USER=admin
ADMIN_DEFAULT_PASS=admin123

# ===============================================
# KONFIGURASI DATABASE MYSQL (Lokal atau TiDB Cloud)
# ===============================================
# Untuk Lokal (XAMPP / phpMyAdmin):
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=mie_jebew_db
# DB_SSL=false

# Untuk Production Cloud (TiDB Cloud Serverless Free):
DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_USER=your_tidb_username.root
DB_PASSWORD=your_tidb_password
DB_NAME=mie_jebew_db
DB_SSL=true

# ===============================================
# OPTIONAL: ANTI-SLEEP KEEP-ALIVE (Render / Koyeb)
# ===============================================
# RENDER_EXTERNAL_URL=https://mie-jebew.onrender.com
